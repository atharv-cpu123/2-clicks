# Local API settings. Copy this file to .env and adjust if needed.
LOG_LEVEL=INFO
PKI_AUTO_REMEDIATE_MEDIUM=false


DATABASE_URL=postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres

# Gemini explanations (get a key from Google AI Studio; keep it private)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Choose gemini or openrouter for the responder Explain button
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
